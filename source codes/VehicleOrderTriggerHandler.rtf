\f0\fs24 \cf0 public class VehicleOrderTriggerHandler \{\
\
    public static void handleTrigger(\
        List<Vehicle_Order__c> newOrders,\
        Map<Id, Vehicle_Order__c> oldOrders,\
        Boolean isBefore,\
        Boolean isAfter,\
        Boolean isInsert,\
        Boolean isUpdate\
    ) \{\
\
   \
        if (isBefore && (isInsert || isUpdate)) \{\
            preventOrderIfOutOfStock(newOrders);\
        \}\
\
        \
        if (isAfter && (isInsert || isUpdate)) \{\
            updateStockOnOrderPlacement(newOrders);\
        \}\
    \}\
\
\
    private static void preventOrderIfOutOfStock(\
        List<Vehicle_Order__c> orders\
    ) \{\
\
        Set<Id> vehicleIds = new Set<Id>();\
\
        for (Vehicle_Order__c order : orders) \{\
            if (order.Vehicle__c != null) \{\
                vehicleIds.add(order.Vehicle__c);\
            \}\
        \}\
\
        if (vehicleIds.isEmpty()) \{\
            return;\
        \}\
\
        Map<Id, Vehicle__c> vehicleStockMap =\
            new Map<Id, Vehicle__c>([\
                SELECT Id, Stock_Quantity__c\
                FROM Vehicle__c\
                WHERE Id IN :vehicleIds\
            ]);\
\
        for (Vehicle_Order__c order : orders) \{\
\
            Vehicle__c vehicle =\
                vehicleStockMap.get(order.Vehicle__c);\
\
            if (\
                vehicle != null &&\
                (vehicle.Stock_Quantity__c == null ||\
                 vehicle.Stock_Quantity__c <= 0)\
            ) \{\
\
                order.addError(\
                    'This vehicle is out of stock. Order cannot be placed.'\
                );\
            \}\
        \}\
    \}\
\
\
    private static void updateStockOnOrderPlacement(\
        List<Vehicle_Order__c> orders\
    ) \{\
\
        System.debug('===== STOCK UPDATE METHOD STARTED =====');\
\
        Set<Id> vehicleIds = new Set<Id>();\
\
        for (Vehicle_Order__c order : orders) \{\
\
            System.debug('Order: ' + order.Id);\
            System.debug('Vehicle: ' + order.Vehicle__c);\
            System.debug('Status: ' + order.Status__c);\
\
            if (\
                order.Vehicle__c != null &&\
                order.Status__c == 'Confirmed'\
            ) \{\
                vehicleIds.add(order.Vehicle__c);\
            \}\
        \}\
\
        System.debug('Vehicle IDs: ' + vehicleIds);\
\
        if (vehicleIds.isEmpty()) \{\
            System.debug('NO VEHICLE IDS FOUND');\
            return;\
        \}\
\
        List<Vehicle__c> vehicles = [\
            SELECT Id, Name, Stock_Quantity__c\
            FROM Vehicle__c\
            WHERE Id IN :vehicleIds\
        ];\
\
        List<Vehicle__c> vehiclesToUpdate =\
            new List<Vehicle__c>();\
\
        for (Vehicle__c vehicle : vehicles) \{\
\
            System.debug(\
                'Vehicle: ' + vehicle.Name +\
                ' | Current Stock: ' +\
                vehicle.Stock_Quantity__c\
            );\
\
            if (\
                vehicle.Stock_Quantity__c != null &&\
                vehicle.Stock_Quantity__c > 0\
            ) \{\
\
                vehicle.Stock_Quantity__c -= 1;\
\
                System.debug(\
                    'New Stock: ' +\
                    vehicle.Stock_Quantity__c\
                );\
\
                vehiclesToUpdate.add(vehicle);\
            \}\
        \}\
\
        if (!vehiclesToUpdate.isEmpty()) \{\
\
            update vehiclesToUpdate;\
\
            System.debug('===== STOCK UPDATED SUCCESSFULLY =====');\
        \}\
    \}\
\}}